# ──────────────────────────────────────────────────────
# Network Faceless Auto-Post — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────

# Google Service Account credentials JSON file path (required)
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable the Google Sheets API, download the JSON key, and share your spreadsheet with
# the service account email (e.g. autopost@project.iam.gserviceaccount.com).
GOOGLE_CREDENTIALS_PATH=config/service_account.json

# Google Spreadsheet ID (required)
# Found in the spreadsheet URL: docs.google.com/spreadsheets/d/{SHEETS_ID}/edit
SHEETS_ID=

# Name of the tab containing the 30-day planogram (optional, default: Planograma)
# Expected columns: Día | Título | Hook | Slide_2 | Slide_3 | Slide_4 | Slide_5 | CTA | Estado
SHEETS_TAB_NAME=Planograma

# Start date of the 30-day plan in YYYY-MM-DD format (required)
# Day 1 of the plan corresponds to this date.
PLAN_START_DATE=2026-06-01

# ──────────────────────────────────────────────────────
# Image Generation (Pollinations.ai — free, no API key)
# ──────────────────────────────────────────────────────

# Fixed seed for the hacker character to maintain visual consistency (optional, default: 1337)
CHARACTER_SEED=1337

# Output image dimensions in pixels (optional, default: 1080x1080)
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080

# ──────────────────────────────────────────────────────
# Image Hosting — imgbb.com (free tier)
# Register at: https://imgbb.com/login → API → Get API key
# Free plan: unlimited uploads, images publicly accessible via URL
# ──────────────────────────────────────────────────────
IMGBB_API_KEY=

# ──────────────────────────────────────────────────────
# Meta Graph API (Instagram Business)
# Setup guide: https://developers.facebook.com/docs/instagram-api/getting-started
# 1. Create a Meta App at developers.facebook.com
# 2. Add Instagram Basic Display + Instagram Graph API products
# 3. Connect your Instagram Business Account to a Facebook Page
# 4. Generate a long-lived User Access Token (60-day expiry, refresh via cron)
# ──────────────────────────────────────────────────────

# Long-lived access token with pages_manage_posts, instagram_basic, instagram_content_publish (required)
META_ACCESS_TOKEN=

# Numeric Instagram Business Account ID (required)
# GET https://graph.facebook.com/v19.0/me/accounts?access_token=TOKEN
# Then GET https://graph.facebook.com/v19.0/{PAGE_ID}?fields=instagram_business_account&access_token=TOKEN
INSTAGRAM_ACCOUNT_ID=

# ──────────────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────────────

# Log verbosity: DEBUG | INFO | WARNING | ERROR (optional, default: INFO)
LOG_LEVEL=INFO

# Local directory for generated images (optional, default: output)
OUTPUT_DIR=output
