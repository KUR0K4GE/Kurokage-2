# Google Gemini API key (required)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# eBay Developer credentials (required)
# Get all three from: https://developer.ebay.com/my/keys
# App ID  = Client ID (used in all API calls as SECURITY-APPNAME)
EBAY_APP_ID=
# Dev ID  = used in X-EBAY-API-DEV-NAME header for Finding API auth
EBAY_DEV_ID=
# Cert ID = Client Secret (used in X-EBAY-API-CERT-NAME header)
EBAY_CERT_ID=
